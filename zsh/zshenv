#!/usr/bin/env zsh
#
# Sourced by EVERY zsh: scripts, `zsh -c`, editor subprocesses, the lot.
# Keep it fork-free -- anything that shells out belongs in .zprofile, which
# runs once per login shell.

export DOTFILES="$HOME/.dotfiles"
export SD_ROOT="$DOTFILES/scripts"

# XDG
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

# editor
export EDITOR="hx"
export VISUAL="hx"

# zsh: config lives in ZDOTDIR, everything zsh *generates* goes elsewhere
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"
export ZSH_CACHE_DIR="$XDG_CACHE_HOME/zsh"     # .zcompdump, completion caches
export ZSH_STATE_DIR="$XDG_STATE_HOME/zsh"     # history
export ZSH_DATA_DIR="$XDG_DATA_HOME/zsh"       # cloned plugins
[[ -d $ZSH_CACHE_DIR ]] || mkdir -p $ZSH_CACHE_DIR
[[ -d $ZSH_STATE_DIR ]] || mkdir -p $ZSH_STATE_DIR

# Keep path/fpath de-duplicated so re-sourcing path.zsh from .zprofile
# reorders rather than appends. Must precede the first path assignment.
typeset -U path fpath

source "$ZDOTDIR/path.zsh"

[[ $OSTYPE == linux* ]] && export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"

return 0
